# ============================================================================
# POS Platform Private Server Environment Configuration (.env.example)
# Reference: docs/05-private-server-deployment.md (Section 8)
# ============================================================================

APP_ENV=production
DEPLOYMENT_MODE=private
TENANT_MODE=single

# Fixed Organization & Deployment Identity (assigned during enrollment)
DEPLOYMENT_ID=018f2b10-0000-7000-8000-000000000001
ORGANIZATION_ID=018f2b10-0000-7000-8000-000000000002
PUBLIC_BASE_URL=https://pos.customer-domain.vn

# Database & Redis (Internal Docker Network only; never exposed on 0.0.0.0)
POSTGRES_DB=pos_business
POSTGRES_USER=business_app
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
DATABASE_URL=postgresql+psycopg2://business_app:CHANGE_ME_STRONG_POSTGRES_PASSWORD@postgres:5432/pos_business
REDIS_URL=redis://redis:6379/0

# Authentication & JWT Secret (32+ random bytes)
JWT_SECRET_KEY=CHANGE_ME_GENERATE_32_BYTE_RANDOM_SECRET

# Mandatory Cloud Control Plane Connection & Ed25519 License Verification
CLOUD_CONTROL_PLANE_URL=https://control.pos-platform.vn
LICENSE_VALIDATION_ENABLED=true
TRUSTED_LICENSE_PUBLIC_KEYS=cp-ed25519-2026-01:REPLACE_WITH_PROVIDER_ED25519_PUBLIC_KEY_B64

